# Copy this file to .env and fill in your real values. Never commit .env.

# Get this from Neon: Dashboard -> your project -> Connection string
# It looks like: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string. Used to sign admin login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API listens on
PORT=4000

# The origin your static site is served from (for local dev, Live Server etc.)
CLIENT_ORIGIN=http://127.0.0.1:5500
