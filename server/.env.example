# Copy this file to .env and fill in your real values. Never commit .env.

# Azure SQL Database connection
SQL_SERVER=openmicdb.database.windows.net
SQL_PORT=1433
SQL_DATABASE=maindb
SQL_USER=openmicadmin
SQL_PASSWORD=replace-with-your-database-password

# Generate a long random value. Used to sign admin login tokens.
JWT_SECRET=replace-with-a-long-random-secret

# API settings
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5500
